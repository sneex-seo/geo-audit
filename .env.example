# Скопіюйте в .env і заповніть потрібне. Без ключів аудит працює, лише без AI-висновку.

# AI-висновок у кінці звіту (Anthropic Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Модель і запасна модель (необов'язково)
GEO_AI_MODEL=
GEO_AI_FALLBACK_MODEL=

# Google API-ключ з увімкненим PageSpeed Insights API і Chrome UX Report API (необов'язково).
# Без ключа PageSpeed працює зі спільною квотою, яка часто вичерпується.
PAGESPEED_API_KEY=

# Вхід за логіном і паролем. Залиште порожнім для локальної роботи, на сервері задайте обов'язково.
GEO_AUDIT_USER=
GEO_AUDIT_PASSWORD=

# Дозволити видаляти аудити з історії (1 - так)
GEO_AUDIT_ALLOW_DELETE=

# Папка даних поза webroot (на nginx, який ігнорує .htaccess). За замовчуванням data/ у корені.
GEO_AUDIT_DATA=
